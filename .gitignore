# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!deploy/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded media
/uploads

# editor/agent artifacts
# NOTE: AGENTS.md is deliberately NOT listed here. It is a tracked project document —
# the deployment facts, intent traps and conventions an agent should read — not a local
# tool artifact. Do not add it back, and do not `git rm --cached` it.
.codebuddy/
.freebuff/
.zcode/
.agents/
.gemini/
.claude/
.commandcode/
.windsurf/
skills-lock.json

# tokens & private data
*cline-tokens*
data/cline-tokens.json

# dev logs & scratch
dev-server.log
scratch/
.token.tmp

# eslint triage artifacts — local working copies.
# Regenerate the report with: npx eslint --format json -o eslint-results.json .
eslint-results.json
scripts/summarize-eslint.js
