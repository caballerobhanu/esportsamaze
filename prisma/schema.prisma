generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GameGenre {
  BATTLE_ROYALE
  TACTICAL_FPS
  MOBA
  FIGHTING
  SPORTS
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
}

enum TransferType {
  JOINED
  LEFT
  LOANED
  BENCHED
}

model GameFamily {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  description String?
  games       Game[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Game {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  shortName   String?      // Compact display label, e.g. "BGMI" for "Battlegrounds Mobile India" (NOT the slug)
  genre       GameGenre
  developer   String?
  logoUrl     String?
  logoDarkUrl String?      // Dark-theme variant of the logo (like Team.imageDarkUrl)
  bannerUrl   String?
  familyId    String?
  family      GameFamily?  @relation(fields: [familyId], references: [id])
  tournaments Tournament[]
  tournamentLinks TournamentGame[]
  matches     Match[]
  teams       Team[]
  players     Player[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Team {
  id                String            @id @default(cuid())
  name              String
  slug              String?           @unique
  displayName       String?
  tag               String?
  logoUrl           String?
  imageDarkUrl      String?
  gameId            String?
  game              Game?             @relation(fields: [gameId], references: [id])
  region            String?
  founded           DateTime?
  status            String            @default("ACTIVE")
  isVerified        Boolean           @default(true)
  sponsors          String?
  socialLinks       Json?
  // Null follows the site-wide setting for team pages; true/false forces it here.
  showViewCount     Boolean?
  // Which window the team page's count covers; null follows the site-wide window.
  viewCountWindow   String?
  players           Player[]
  transferHistory   Transfer[]
  transferHistoryIn Transfer[]        @relation("TransferFromTeam")
  tournamentRosters TournamentTeam[]
  matchResults      MatchTeamResult[]
  matchPlayerStats  MatchPlayerStat[]
  tournamentsWon    Tournament[]      @relation("TournamentWinner")
  tournamentsRunnerUp Tournament[]    @relation("TournamentRunnerUp")
  articles          Article[]
  teamTotals        TournamentTeamTotals[]
  reportedTotals    TournamentPlayerTotals[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([name])
  @@index([tag])
  @@index([gameId])
}

model Player {
  id              String            @id @default(cuid())
  ign             String
  slug            String?           @unique
  firstName       String?
  lastName        String?
  avatarUrl       String?
  nationality     String?
  role            String?
  birthDate       DateTime?
  status          String            @default("ACTIVE")
  isVerified      Boolean           @default(true)
  // Null follows the site-wide setting for player pages; true/false forces it here.
  showViewCount   Boolean?
  // Which window the player page's count covers; null follows the site-wide window.
  viewCountWindow String?
  isPlayer        Boolean           @default(true) // false = staff-only member (never appears in playing rosters)
  staffRole       String?           // Set when the person also serves as support staff: "Head Coach", "Analyst", "Manager"…
  gameId          String?
  game            Game?             @relation(fields: [gameId], references: [id])
  socialLinks     Json?
  currentTeamId   String?
  currentTeam     Team?             @relation(fields: [currentTeamId], references: [id])
  // Roster membership is stored, not derived: it is set by event/scorecard imports
  // and admin roster edits (never by the Transfer ledger, which is admin-only
  // history). This timestamp gates older sources so importing an event that
  // happened before the current team cannot move the player back.
  currentTeamSince DateTime?
  transferHistory Transfer[]
  matchStats      MatchPlayerStat[]
  reportedTotals  TournamentPlayerTotals[]
  articles        Article[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([ign])
  @@index([currentTeamId])
  @@index([gameId])
  @@index([isPlayer, status])
}

model Transfer {
  id         String       @id @default(cuid())
  playerId   String
  player     Player       @relation(fields: [playerId], references: [id])
  fromTeamId String?      // Previous team — present when this is a team→team move
  fromTeam   Team?        @relation("TransferFromTeam", fields: [fromTeamId], references: [id])
  teamId     String
  team       Team         @relation(fields: [teamId], references: [id])
  type       TransferType
  staffRole  String?      // Set when this move is a staff appointment: "Coach", "Analyst"…
  date       DateTime
  notes      String?
  // Same-day moves are ordered by insertion time: the ledger fold in
  // lib/player-transfer-rule.ts breaks date ties with this, so two rows sharing
  // a date can no longer resolve in whatever order the DB returns them.
  createdAt  DateTime     @default(now())

  @@index([playerId])
  @@index([playerId, date])
  @@index([fromTeamId])
  @@index([teamId])
  @@index([date])
}

model Organizer {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  logoUrl     String?
  website     String?
  type        String?               @default("PRIMARY") // PRIMARY, CO_ORGANIZER, BROADCASTER
  tournaments TournamentOrganizer[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Sponsor {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  logoUrl     String?
  website     String?
  category    String?             // TITLE_SPONSOR, PRESENTING, DEVICE_PARTNER, TICKETING, BROADCAST
  tournaments TournamentSponsor[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Venue {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  city        String?
  country     String?
  capacity    Int?
  mapUrl      String?
  tournaments TournamentVenue[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model TournamentOrganizer {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  organizerId  String
  organizer    Organizer  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  role         String?    // LEAD, HOST, BROADCASTER

  @@unique([tournamentId, organizerId])
}

model TournamentSponsor {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  sponsorId    String
  sponsor      Sponsor    @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  tier         String?    // TITLE, POWERED_BY, ASSOCIATE

  @@unique([tournamentId, sponsorId])
}

model TournamentVenue {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  venueId      String
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stageName    String?    // e.g. "Grand Finals", "Playoffs"

  @@unique([tournamentId, venueId])
}

/// A regional grouping a publisher uses ("EMEA", "SEA", or "India" on its own),
/// offered when a tournament place names a region. Admin-managed, because the
/// groupings change by season. It deliberately does not list countries: nothing
/// derives a region's members, so old events cannot be rewritten by an edit here.
model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  position  Int      @default(0) // display order
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id                String                @id @default(cuid())
  gameId            String
  game              Game                  @relation(fields: [gameId], references: [id])
  name              String
  slug              String                @unique
  shortName         String?               // Custom short name (e.g. "BGMS 2026", "BGIS 2024")
  series            String?               // Blanket Series (e.g. BGIS, BMPS, PMGC)
  season            String?               // Season / Series Label (e.g. "2026 Edition", "Season 3")
  seriesValue       Int?                  // Priority weight or series index
  tier              String                // S-Tier, A-Tier, B-Tier, C-Tier, Qualifier
  rankingIncluded   Boolean               @default(true) // false = excluded from KRAFTON rankings (points rows for it are ignored)
  // Null follows the site-wide setting for tournament pages; true/false forces it here.
  showViewCount     Boolean?
  // Which window the tournament page's count covers; null follows the site-wide window.
  viewCountWindow   String?
  // How many seats the teams tab presents, so an announced field shows its full
  // size before the teams are known. Null presents only what is recorded.
  teamsToShow       Int?
  status            TournamentStatus      @default(UPCOMING)
  eventType         String?               @default("LAN") // Online, LAN, Hybrid
  gameMode          String?               @default("Squads TPP") // TPP Squad, FPP Squad, Duo, Solo
  platform          String?               @default("Mobile") // Mobile, PC, PlayStation, Xbox, Nintendo Switch, Cross-Platform
  device            String?               // Official / Sponsored Tournament Device (e.g. Realme GT 7 Pro, Infinix GT 20 Pro)
  region            String?
  countries         Json?                 // List of country names / codes
  prizePool         Float?
  currency          String                @default("USD")
  usdRate           Float?
  prizeDistribution Json?                 // Multi-stage or flat [{ rank: '1st', prize: 1000000, percentage: 40, qualifications: [...] }, ...]
  qualifications    Json?                 // [{ place: "1st", events: ["PMGC 2025", "EWC 2025"] }, ...]
  startDate         DateTime
  endDate           DateTime
  // How precisely the dates are known: "DAY" (default) or "MONTH" when the day is
  // unknown. MONTH stores the 1st of the start month and the last day of the end
  // month, so ranges, status derivation and sorting all keep working.
  datePrecision     String                @default("DAY")
  winnerTeamId      String?
  winnerTeam        Team?                 @relation("TournamentWinner", fields: [winnerTeamId], references: [id])
  winner            String?               // Cached winner display name
  runnerUpTeamId    String?
  runnerUpTeam      Team?                 @relation("TournamentRunnerUp", fields: [runnerUpTeamId], references: [id])
  runnerUp          String?               // Cached runner-up display name
  imageUrl          String?               // Light Logo
  imageDarkUrl      String?               // Dark Logo
  bannerUrl         String?               // Tournament Header Banner
  liquipedia        String?
  socialLinks       Json?                 // { website, instagram, twitter, facebook, youtube, kick, twitch, discord }
  formatDetails     Json?                 // Detailed format rules & points distribution system
  standingsConfig   Json?                 // Standings display config: logoMode, showOverall, filters[], columns[], zones[], stages{}
  // Legacy database columns mapped to keep backwards-compatibility without dropping columns
  legacyOrganizer   String?               @map("organizer")
  legacySponsors    String?               @map("sponsors")
  legacyMode        String?               @map("mode")
  legacyType        String?               @map("type")
  legacyLocation    String?               @map("location")
  legacyVenue       String?               @map("venue")
  
  organizers        TournamentOrganizer[]
  sponsors          TournamentSponsor[]
  venues            TournamentVenue[]
  stages            TournamentStage[]
  teams             TournamentTeam[]
  seededTeams       TournamentTeam[]      @relation("TournamentTeamSeedEvent")
  games             TournamentGame[]
  matches           Match[]
  articles          Article[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  kraftonEvents KraftonEvent[]
  teamTotals    TournamentTeamTotals[]
  playerTotals  TournamentPlayerTotals[]

  @@index([status, startDate])
  @@index([name])
  @@index([gameId])
  @@index([series])
}

model TournamentGame {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  gameId       String
  game         Game       @relation(fields: [gameId], references: [id])
  position     Int        @default(0)

  @@unique([tournamentId, gameId])
  @@index([gameId])
}



// Time-based point transfers: points a team earned on/before `before`
// are attributed to the acquiring org (see lib/krafton-rankings.ts).

model TournamentStage {
  id           String            @id @default(cuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String            // e.g. "Grand Finals", "Semifinals", "Survival Stage"
  sequence     Int
  formatType   String            // "Battle Royale Points Table", "Round Robin", "Single Elimination"
  stageType    String?           @default("GROUPS_WISE") // "ROUND_ROBIN", "GROUPS_WISE", "SWISS", "PLAYOFFS"
  groups       TournamentGroup[]
  matches      Match[]
  teamTotals   TournamentTeamTotals[]
  playerTotals TournamentPlayerTotals[]
}

model TournamentGroup {
  id      String          @id @default(cuid())
  stageId String
  stage   TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name    String          // e.g. "Group A", "Group B", "Group 1"
  matches Match[]
}

/// A seat in an event, which may not be filled yet.
///
/// `teamId` is nullable so an announced field can be recorded before its teams
/// are known. An unfilled seat keeps its entry label (`seedLabel`, shown as the
/// row's name), its region (`country`) and the qualifier it comes through
/// (`seedTournamentId`, whose logo and link stand in for a team's). Every reader
/// must tolerate a row with no team: it is a seat, not a competitor, and it takes
/// no part in standings, prize money or structured data.
model TournamentTeam {
  id               String      @id @default(cuid())
  tournamentId     String
  tournament       Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId           String?
  team             Team?       @relation(fields: [teamId], references: [id])
  seed             Int?
  seedLabel        String?     // Custom seed / entry reason (e.g. "Direct Invite", "BGIS 2026 Champion", "Survival Stage Slot")
  seedTournamentId String?     // Optional linked tournament ID if seeded from a prior event in DB
  seedTournament   Tournament? @relation("TournamentTeamSeedEvent", fields: [seedTournamentId], references: [id], onDelete: SetNull)
  berths           Json?       // Events this finish qualified the team into: [{ name, tournamentId?, tournamentSlug? }, ...]
  finalRank        Int?
  prizeWon         Float?
  logoUrl          String?     // Event-specific team logo override (light)
  logoDarkUrl      String?     // Event-specific team logo override (dark)
  shortName        String?     // Event-specific short name / tag override
  displayName      String?     // Event-specific display name override (e.g. sponsor name)
  /// Doubles as the grouping the teams tab uses. A slot may name a region
  /// ("EMEA") instead of, or above, a country ("Turkey").
  country          String?     // Event-specific country override (name or ISO code)
  region           String?     // Regional grouping a slot belongs to (EMEA, SEA, CSA…)
  rosterJson       Json        // Array of player IGNs, roles, captain flag

  @@unique([tournamentId, teamId])
  @@index([teamId])
}

model Match {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        TournamentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  groupId      String?
  group        TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  gameId       String
  game         Game             @relation(fields: [gameId], references: [id])
  matchNumber        Int?             @default(1)
  overallMatchNumber Int?
  stageType          String?          // "Round Robin", "Groups Wise", "Grand Finals"
  groupName          String?          // "Group A vs Group B"
  mapName            String?          // "Erangel", "Miramar", "Sanhok", "Vikendi", "Rondo"
  matchType          String?          @default("LAN") // "Online", "Offline", "LAN"
  format             String           // Match title / label e.g. "Match 1 (Erangel)"
  status             MatchStatus      @default(SCHEDULED)
  scheduledAt        DateTime
  matchTime          String?          // e.g. "17:30 IST"
  streamUrl          String?
  vods               Json?            // Array of { title, type, language, platform, url }
  games              MatchGame[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@index([tournamentId, matchNumber])
  @@index([stageId])
  @@index([groupId])
  @@index([status, scheduledAt])
}

model MatchGame {
  id          String            @id @default(cuid())
  matchId     String
  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sequence    Int               @default(1)
  mapName     String?
  duration    Int?              // Duration in seconds
  teamResults MatchTeamResult[]
  playerStats MatchPlayerStat[]

  @@unique([matchId, sequence])
  @@index([matchId])
}

model MatchTeamResult {
  id             String    @id @default(cuid())
  matchGameId    String
  matchGame      MatchGame @relation(fields: [matchGameId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team      @relation(fields: [teamId], references: [id])
  shortCode      String?   // Team Tag / Short Code
  mp             Int       @default(1) // Matches Played
  rank           Int       @default(1) // Match placement rank (1..16/24)
  wwcd           Boolean   @default(false) // Winner Winner Chicken Dinner / 1st
  placePoints    Int       @default(0) // Placement Points
  elimsPoints    Int       @default(0) // Elimination Points
  bonusPoints    Int       @default(0) // Bonus Points
  totalPoints    Int       @default(0) // placePoints + elimsPoints + bonusPoints
  // Detail / telemetry fields — nullable with NO default. A surviving
  // `@default(0)` would silently re-fabricate the zeros the nullable-stats
  // migration removes, making "not recorded" look like a real zero again.
  damage         Float?   // Damage done
  survivalTime   Int?     // Survival time in seconds
  healing        Int?     // Healing items used
  damageReceived Float?   // Damage received
  headshots      Int?     // Headshots count
  assists        Int?     // Assists count
  knockouts      Int?     // Knockouts count
  longestElim    Float?   // Longest elimination distance (meters)
  vehicleElims   Int?     // Vehicle eliminations
  grenadeElims   Int?     // Grenade eliminations
  smokesUsed     Int?     // Smokes used
  grenadesUsed   Int?     // Grenades used
  molotovsUsed   Int?     // Molotovs used
  flashUsed      Int?     // Flash used
  utilitiesTotal Int?     // smokes + grenades + molotovs + flash
  airdrops       Int?     // Airdrops looted
  rescues        Int?     // Rescues / revives done
  distDrove      Float?   // Distance drove in vehicle
  distWalk       Float?   // Distance walked
  totalDist      Float?   // distDrove + distWalk
  won            Boolean   @default(false) // Legacy alias for won
  score          Int?      // Legacy score
  rawData        Json?

  // One result row per team per game — without this, double-submits or two
  // concurrent admins silently double-count a team's points in standings.
  @@unique([matchGameId, teamId])
  @@index([teamId])
}

model MatchPlayerStat {
  id             String    @id @default(cuid())
  matchGameId    String
  matchGame      MatchGame @relation(fields: [matchGameId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id])
  teamId         String?
  team           Team?     @relation(fields: [teamId], references: [id])
  shortCode      String?   // Team tag
  role           String?   // Assaulter, IGL, Support, Sniper, Flex
  mp             Int       @default(1)
  playerElims    Int       @default(0)
  teamRank       Int       @default(0)
  teamWwcd       Boolean   @default(false)
  teamPlacePoints Int      @default(0)
  teamElimsPoints Int      @default(0)
  teamBonusPoints Int      @default(0)
  teamTotalPoints Int      @default(0)
  // Detail / telemetry fields — nullable with NO default (see MatchTeamResult).
  damage         Float?
  survivalTime   Int?
  healing        Int?
  damageReceived Float?
  headshots      Int?
  assists        Int?
  knockouts      Int?
  longestElim    Float?
  vehicleElims   Int?
  grenadeElims   Int?
  smokesUsed     Int?
  grenadesUsed   Int?
  molotovsUsed   Int?
  flashUsed      Int?
  utilitiesTotal Int?
  airdrops       Int?
  rescues        Int?
  distDrove      Float?
  distWalk       Float?
  totalDist      Float?
  isMvp          Boolean?
  playerPowerplay Int?     // Eliminations in Zone 1 / Powerplay
  kills          Int       @default(0) // Legacy alias for playerElims
  deaths         Int?
  rawData        Json?

  // One stat row per player per game (see MatchTeamResult for the rationale).
  @@unique([matchGameId, playerId])
  @@index([playerId])
  @@index([teamId])
}

model Article {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  subHeadline     String?
  excerpt         String?
  keyTakeaways    String[]     @default([])
  content         String       @db.Text
  coverImage      String?
  coverImageAlt   String?
  coverImageCaption String?
  coverImageCredit  String?
  category        String       @default("GENERAL") // TOURNAMENTS, ROSTERS, ANALYSIS, INTERVIEWS, GENERAL
  categories      String[]     @default([])
  tags            String[]     @default([])
  authorName      String       @default("Esports Amaze Staff")
  authorRole      String?      @default("Editor")
  featured        Boolean      @default(false)
  status          String       @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PRIVATE, SCHEDULED, PUBLISHED
  readTimeMinutes Int          @default(3)
  publishedAt     DateTime     @default(now())
  views           Int          @default(0)
  allowComments   Boolean      @default(true)
  faqs            Json?        // Array of { question: string, answer: string }

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  focusKeyword    String?
  secondaryKeywords String[]   @default([])

  tournamentId    String?
  tournament      Tournament?  @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  playerId        String?
  player          Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  revisions ArticleRevision[]
  reactions ArticleReaction[]
  comments  Comment[]

  @@index([publishedAt])
  @@index([category])
  @@index([featured])
  @@index([title])
  @@index([tournamentId])
  @@index([teamId])
  @@index([playerId])
}

model ArticleRevision {
  id              String   @id @default(cuid())
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId       String
  title           String
  subHeadline     String?
  excerpt         String?
  keyTakeaways    String[] @default([])
  content         String   @db.Text
  coverImage      String?
  coverImageAlt   String?
  coverImageCaption String?
  coverImageCredit  String?
  categories      String[] @default([])
  tags            String[] @default([])
  authorName      String
  authorRole      String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  focusKeyword    String?
  secondaryKeywords String[] @default([])
  faqs            Json?
  playerId        String?
  wordCount       Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([articleId, createdAt])
}

model ArticleReaction {
  id        String   @id @default(cuid())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  sessionId String
  kind      String   @default("LIKE") // LIKE, HYPE, INSIGHT
  createdAt DateTime @default(now())

  @@unique([articleId, sessionId, kind])
  @@index([articleId])
}

model Comment {
  id         String   @id @default(cuid())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId  String
  authorName String   @default("Guest")
  body       String   @db.Text
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now())

  @@index([articleId, status])
  @@index([status])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String   @unique
  contentHash  String?
  originalName String?
  mimeType     String?
  size         Int      @default(0)
  alt          String?
  createdAt    DateTime @default(now())

  // Not unique on purpose. Uniqueness would stop the table from recording a duplicate at
  // all, which is the state the duplicates report exists to find. Uploads are matched
  // against existing assets by hash before anything is stored; this index backs that
  // lookup and the report's grouping.
  @@index([contentHash])
}

// Anonymous counters for the compare page's "most compared" default lists.
// No user data — one row per entity, incremented on each explicit compare view.
model ComparePick {
  id         String   @id @default(cuid())
  entityType String   // 'TEAM' | 'PLAYER'
  entityId   String
  picks      Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, picks])
}

// ═══ KRAFTON official rankings (standalone system, v2) ═══
// A ranking event is fully standalone from the Tournament system: admins
// enter events (name, end date, tier) and paste final placements/finishes.

enum KraftonBoard {
  TEAM
  PLAYER
}

model KraftonEvent {
  id           String         @id @default(cuid())
  name         String
  shortName    String? // display label on mobile, where the full name will not fit
  endDate      DateTime // decay anchor — days are measured from this date
  tier         String         @default("Tier 1") // Publisher | Tier 1 | Tier 2 | Tier 3
  tournamentId String? // optional back-reference to a site tournament page
  tournament   Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  entries      KraftonEntry[]

  @@index([endDate])
}

// One placement row per entity per event. entityName works standalone;
// entityId optionally links to a site Team/Player page (manual assignment).
// PLAYER entries carry the team they played under for that event plus
// finishes and KRAFTON award counts (MVP, Finals MVP, IGL, Survivor, Emerging).
model KraftonEntry {
  id         String       @id @default(cuid())
  eventId    String
  event      KraftonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  board      KraftonBoard
  entityId   String?
  entityName String
  teamName   String?
  teamId     String?
  rank       Int          @default(0)
  finishes   Int          @default(0)
  mvp        Int          @default(0)
  finalsMvp  Int          @default(0)
  igl        Int          @default(0)
  survivor   Int          @default(0)
  emerging   Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([eventId, board, entityName])
  @@index([board, entityId])
  @@index([eventId])
}

// Point transfer between two ranked entities (org rebrand / roster acquisition).
// A's event entries that ended BEFORE `cutoff` are attributed to B (decay
// unchanged, anchored to each event). mode 'wipe' also erases B's own
// pre-cutoff points; amountOverride transfers a fixed sum instead of the
// actual balance. Entities must be site-linked (team ids).
model KraftonTransfer {
  id         String   @id @default(cuid())
  fromTeamId String
  fromName   String
  toTeamId   String
  toName     String
  cutoff     DateTime
  mode       String   @default("add") // 'add' | 'wipe'
  amount     Int?     // fixed transfer amount; null = actual balance
  createdAt  DateTime @default(now())

  @@index([toTeamId])
}

// ═══ Reported tournament totals (match-free) ═══
// Events arrive in shapes that can never align match-wise: a day-wise sheet
// (PMWC), a stage summary (BMPS 2025 finals), or a whole-event table. Those are
// entered here and NOT through the scorecard matrix, and deliberately share no
// relation with Match / MatchGame / MatchPlayerStat / MatchTeamResult: this data
// is never averaged per game and never summed together with match data.
//
// The ladder is DAY → STAGE → EVENT and rolls upward. A parent level is read from
// its own row only when it has NO child rows; otherwise it is the sum of its
// children. Entering both a parent and its children is a conflict, not a merge.

enum AggregateScope {
  DAY
  STAGE
  EVENT
}

model TournamentTeamTotals {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scope        AggregateScope
  stageId      String?
  stage        TournamentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  // Free-text slice label: "Day 3", "Grand Finals", "" for the whole event.
  label        String          @default("")
  // Uniqueness key for the slice. A nullable stageId cannot join a Postgres unique
  // index (NULLs are distinct, so duplicates would slip through), so the slice
  // identity is stored directly instead of inferred.
  sliceKey     String
  teamId       String
  team         Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // Totals and counts only — every average is derived (total ÷ matches) so the
  // ladder can be summed without ever double-counting.
  placement    Int?
  matches      Int?
  wwcd         Int?
  placePoints  Int?
  elimsPoints  Int?
  bonusPoints  Int?
  totalPoints  Int?
  finishes     Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tournamentId, sliceKey, teamId])
  @@index([tournamentId, scope])
  @@index([teamId])
}

model TournamentPlayerTotals {
  id           String          @id @default(cuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scope        AggregateScope
  stageId      String?
  stage        TournamentStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  label        String          @default("")
  sliceKey     String
  playerId     String
  player       Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Which team they played for in this slice. This is also what makes a reported
  // row count as event participation for career history and line-ups.
  teamId       String?
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matches      Int?
  playerElims  Int?
  damage       Float?
  headshots    Int?
  assists      Int?
  knockouts    Int?
  survivalTime Int? // total seconds survived, so it sums up the ladder
  healing      Int?
  airdrops     Int?
  rescues      Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tournamentId, sliceKey, playerId])
  @@index([tournamentId, scope])
  @@index([playerId])
  @@index([teamId])
}

// ═══ Page views ═══
// One row per page per day, so the table answers both "how many in total" (sum)
// and "how many lately" (the recent rows) without a second schema. Views are
// recorded by a client beacon rather than in the render: the tournament routes
// are ISR-cached, so a server-side counter would fire once per revalidation
// window instead of once per visit.

enum PageViewEntity {
  TOURNAMENT
  TEAM
  PLAYER
}

model PageView {
  id         String          @id @default(cuid())
  entityType PageViewEntity
  entityId   String
  // Date-only: the day the views belong to, in UTC.
  day        DateTime        @db.Date
  count      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([entityType, entityId, day])
  @@index([entityType, day])
  @@index([entityId])
}

// Key-value store for global site configuration (maintenance mode, coming soon, announcements)
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Every slug a player, team or tournament has previously answered to.
///
/// Written whenever a slug changes, and on a merge (where the absorbed row's slug
/// is re-pointed at the survivor). The public [slug] routes fall back to this table
/// when a slug no longer resolves live, so an inbound link or accumulated ranking
/// survives a rename instead of 404ing. The unique index doubles as the read path.
model SlugHistory {
  id         String   @id @default(cuid())
  entityType String // 'player' | 'team' | 'tournament'
  oldSlug    String
  entityId   String // the surviving entity's id
  changedAt  DateTime @default(now())

  @@unique([entityType, oldSlug])
}

