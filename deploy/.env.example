# Production Environment Configuration
NODE_ENV="production"
PORT=3000

# Canonical Site URL (Matches your domain and SSL certificate)
NEXT_PUBLIC_SITE_URL="https://esportsamaze.com"

# PostgreSQL Connection (Docker container running on VPS port 5433)
# Sized with connection_limit=10 per PM2 worker (2 workers = 20 connections total)
POSTGRES_PASSWORD="YOUR_STRONG_POSTGRES_PASSWORD"
DATABASE_URL="postgresql://postgres:YOUR_STRONG_POSTGRES_PASSWORD@127.0.0.1:5433/esportsamaze?schema=public&connection_limit=10"

# Admin Authentication
# 1. ADMIN_PASSWORD: The strong password you type on /admin/login to sign in
ADMIN_PASSWORD="ChooseAStrongAdminPasswordHere!"

# 2. ADMIN_SESSION_SECRET: A random 32+ character hex string used to cryptographically HMAC-sign session cookies
# Generate on your VPS using: openssl rand -hex 32
ADMIN_SESSION_SECRET="replace_with_openssl_rand_hex_32_output"

# (Optional) Cloudflare R2 Object Storage (10GB Free Tier, $0 Egress Fees)
# Production sets the account id, keys and bucket name — but NOT R2_PUBLIC_URL.
# With no public URL, media is served by this app at /api/media/<filename>
# (root-relative; local disk first, then R2). Setting a public URL instead makes
# every stored URL absolute on that host, which additionally requires that host
# in images.remotePatterns of next.config.ts before next/image can use it.
# CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
# CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
# CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# CLOUDFLARE_R2_BUCKET_NAME="esportsamaze-media"
# CLOUDFLARE_R2_PUBLIC_URL="https://media.esportsamaze.com"
