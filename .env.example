# Database (Postgres via Prisma)
# Sized with connection_limit=10 per cluster worker:
DATABASE_URL="postgresql://postgres:YOUR_STRONG_POSTGRES_PASSWORD@127.0.0.1:5433/esportsamaze?schema=public&connection_limit=10"

# Optional scratch DB for local `prisma migrate dev` / `migrate diff` only.
# Never needed in production.
# SHADOW_DATABASE_URL=

# Admin panel auth (secure HMAC-SHA256 timestamped session tokens)
# Set a strong password for /admin/login:
ADMIN_PASSWORD=
# Generate a random 256-bit secret using `openssl rand -hex 32`:
ADMIN_SESSION_SECRET=

# Canonical site URL, no trailing slash (used for metadataBase, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://esportsamaze.com

# Google AdSense publisher client, e.g. ca-pub-1234567890123456.
# When set: the AdSense loader script runs, ads.txt serves the google.com record,
# and <AdSlot> units render. Leave empty until the site is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=
