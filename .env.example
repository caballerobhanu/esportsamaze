# Database (Postgres via Prisma)
DATABASE_URL=

# Admin panel auth (session token = SHA-256 of ADMIN_SESSION_SECRET::esportsamaze-admin,
# falls back to ADMIN_PASSWORD when no secret is set)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Canonical site URL, no trailing slash (used for metadataBase, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://esportsamaze.com

# Google AdSense publisher client, e.g. ca-pub-1234567890123456.
# When set: the AdSense loader script runs, ads.txt serves the google.com record,
# and <AdSlot> units render. Leave empty until the site is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=
